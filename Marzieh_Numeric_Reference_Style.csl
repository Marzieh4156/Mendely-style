<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info>
    <title>Marzieh Numeric Journal Article Style</title>
    <id>http://www.zotero.org/styles/marzieh-numeric-journal-article</id>
    <link href="http://www.zotero.org/styles/marzieh-numeric-journal-article" rel="self"/>
    <author><name>Marzieh</name></author>
    <category citation-format="numeric"/>
    <summary>Numeric in-text citations with journal article titles in quotation marks and italic journal names.</summary>
    <updated>2026-10-06T00:00:00+00:00</updated>
  </info>
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with=". " delimiter=", " and="text" delimiter-precedes-last="always" et-al-min="4" et-al-use-first="1"/>
      <et-al/>
    </names>
  </macro>
  <macro name="issued">
    <date variable="issued"><date-part name="year"/></date>
  </macro>
  <macro name="title">
    <text variable="title" quotes="true"/>
  </macro>
  <macro name="container">
    <text variable="container-title" font-style="italic"/>
  </macro>
  <citation collapse="citation-number">
    <sort><key variable="citation-number"/></sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography second-field-align="flush">
    <layout>
      <text variable="citation-number" suffix=". "/>
      <group delimiter=", ">
        <text macro="author"/>
        <text macro="title"/>
        <text macro="container"/>
        <text variable="volume" prefix="Vol. "/>
        <text variable="page" prefix="pp. "/>
        <text macro="issued"/>
      </group>
      <text value="."/>
    </layout>
  </bibliography>
</style>
