<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info>
    <title>Marzieh Custom Journal Article Style</title>
    <id>http://www.zotero.org/styles/marzieh-custom-journal-article</id>
    <link href="http://www.zotero.org/styles/marzieh-custom-journal-article" rel="self"/>
    <author><name>Marzieh</name></author>
    <category citation-format="author-date"/>
    <summary>Journal article references with quoted article titles, italic journal names, volume, pages or article number, and year.</summary>
    <updated>2026-10-06T00:00:00+00:00</updated>
  </info>
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with=". " delimiter=", " and="text" delimiter-precedes-last="always" et-al-min="4" et-al-use-first="1"/>
      <et-al/>
    </names>
  </macro>
  <macro name="issued">
    <date variable="issued"><date-part name="year"/></date>
  </macro>
  <macro name="title">
    <text variable="title" quotes="true"/>
  </macro>
  <macro name="container">
    <text variable="container-title" font-style="italic"/>
  </macro>
  <citation>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <names variable="author">
          <name form="short" and="text" delimiter=", " et-al-min="4" et-al-use-first="1"/>
          <et-al/>
        </names>
        <text macro="issued"/>
      </group>
    </layout>
  </citation>
  <bibliography hanging-indent="true">
    <sort><key macro="author"/><key variable="issued"/></sort>
    <layout suffix=".">
      <group delimiter=", ">
        <text macro="author"/>
        <text macro="title"/>
        <text macro="container"/>
        <text variable="volume" prefix="Vol. "/>
        <text variable="page" prefix="pp. "/>
        <text macro="issued"/>
      </group>
    </layout>
  </bibliography>
</style>
